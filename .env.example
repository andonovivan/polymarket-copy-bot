# ── Run mode ──
MODE=paper                     # paper (default) | live | backtest
# Live mode also requires --live AND POLYMARKET_BOT_LIVE=1.
POLYMARKET_BOT_LIVE=0

# ── Polymarket API credentials (required for live; recommended for accurate quotes in paper) ──
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=

# ── Wallet ──
# Private key of the wallet that will place real bets in live mode. NEVER commit.
PRIVATE_KEY=

# ── Strategy / risk ──
STRATEGY=momentum_logit
EDGE_THRESHOLD=0.03            # |p_model - p_market| min edge to bet
KELLY_FRACTION=0.25            # fractional-Kelly multiplier
MAX_BET_PCT=0.05               # hard cap as % of bankroll
MIN_MARKET_DEPTH_USD=50
COOLDOWN_BARS=0                # bars to skip after a loss (0 = none)
LOCK_BUFFER_SECONDS=30         # skip markets within N seconds of resolution

# ── Model training ──
MODEL_WINDOW_DAYS=60
MODEL_RETRAIN_CRON=0 4 * * *   # UTC

# ── Bankroll ──
STARTING_BANKROLL=100          # used in paper / backtest

# ── Bot cadence ──
TICK_SECONDS=60
LOG_LEVEL=INFO

# ── Dashboard ──
DASHBOARD_PORT=8080            # http://localhost:8080

# ── Advanced (usually leave defaults) ──
CLOB_API_URL=https://clob.polymarket.com
CHAIN_ID=137
