# ── Run mode ──
MODE=paper                     # paper (default) | live
# Live mode also requires --live AND POLYMARKET_BOT_LIVE=1.
POLYMARKET_BOT_LIVE=0

# ── Polymarket API credentials (required for live; not needed for paper) ──
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=

# ── Wallet ──
# Private key of the wallet that places real orders in live mode. NEVER commit.
PRIVATE_KEY=

# ── Strategy ──
STRATEGY=spread_only
BASE_SPREAD=0.02               # target $-spread around fair value
MAX_INVENTORY_SHARES=20        # per-side soft cap
INVENTORY_SKEW=0.0005          # $/share quote shift per share of net imbalance
LOCK_BUFFER_SECONDS=30         # cancel quotes within N s of resolution

# ── Bankroll ──
STARTING_BANKROLL=100

# ── Bot cadence ──
TICK_SECONDS=5                 # MM cadence (markets only live for 300s)
LOG_LEVEL=INFO

# ── Dashboard ──
DASHBOARD_PORT=8080

# ── Advanced (usually leave defaults) ──
CLOB_API_URL=https://clob.polymarket.com
CHAIN_ID=137
