# Run mode
MODE=paper
POLYMARKET_BOT_LIVE=0

# Polymarket API credentials (required for live; optional for paper)
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=

# Wallet
# Private key of the wallet that places real orders in live mode. NEVER commit.
PRIVATE_KEY=

# Strategy
STRATEGY=weather_forecast

# Weather: city allowlist (Phase 0.5 backtest favoured EU/Asia)
WEATHER_CITIES=paris,madrid,london,tokyo
DAYS_AHEAD=4

# Edge / sizing
EDGE_THRESHOLD=0.05
KELLY_FRACTION=0.25
MAX_BET_PCT=0.05
MAX_TOTAL_EXPOSURE_PCT=0.30
MIN_MARKET_DEPTH_USD=20
LOCK_BUFFER_SECONDS=600

# Fees (taker-side weather markets: 5% on winnings per gamma feeSchedule)
WINNING_FEE_BPS=500

# Equity sampling
EQUITY_SAMPLE_SECONDS=60

# Bankroll
STARTING_BANKROLL=100

# Bot cadence
TICK_SECONDS=60
LOG_LEVEL=INFO

# Dashboard
DASHBOARD_PORT=8080

# Advanced (usually leave defaults)
CLOB_API_URL=https://clob.polymarket.com
CHAIN_ID=137
